# Docker Configuration Directory
# This directory contains configuration files that are mounted into the container

# Production configuration template
# Copy this file to .env and fill in your actual values
# Never commit secrets to version control

# Runtime Configuration
NODE_ENV=production
PORT=3001
HEALTH_PORT=3001

# Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WhatsApp Configuration  
WHATSAPP_SESSION_ID=your-session-id-here
WHATSAPP_RETRY_DELAY_MS=5000
WHATSAPP_MAX_RETRIES=3

# AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Monitoring Configuration
MONITORING_GROUPS=group1,group2,group3
MAX_MESSAGES_PER_GROUP=100
MESSAGE_PROCESSING_INTERVAL_MS=30000
CONTENT_GENERATION_INTERVAL_MS=300000
SOCIAL_MEDIA_INTERVAL_MS=60000

# Social Media Configuration
INSTAGRAM_ACCESS_TOKEN=your-instagram-token-here
INSTAGRAM_ACCOUNT_ID=your-instagram-id-here
FACEBOOK_ACCESS_TOKEN=your-facebook-token-here
TWITTER_BEARER_TOKEN=your-twitter-token-here
LINKEDIN_ACCESS_TOKEN=your-linkedin-token-here

# Logging Configuration
LOG_LEVEL=info
ENABLE_CONSOLE_LOGGING=true
ENABLE_FILE_LOGGING=true
LOG_FILE_PATH=/app/logs/app.log
ENABLE_TRACING=true

# Security Configuration
ENABLE_HEALTH_SERVER=true
HEALTH_SERVER_PORT=3001
HEALTH_SERVER_HOST=0.0.0.0
ENABLE_CORS=true

# Database password (if using local database)
# DB_PASSWORD=your-database-password-here

# Example environment variables for different environments:
# Development:
# NODE_ENV=development
# LOG_LEVEL=debug
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Staging:
# NODE_ENV=staging
# LOG_LEVEL=info
# ENABLE_HEALTH_SERVER=true

# Production:
# NODE_ENV=production
# LOG_LEVEL=warn
# ENABLE_HEALTH_SERVER=true
# HEALTH_SERVER_HOST=0.0.0.0